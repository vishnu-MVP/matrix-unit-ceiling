+// ---- PQ2_0 (Bonsai ternary, group 128) AMX/VNNI support ----------------------
+// packed_B layout per 16-row tile:
+//   qs {QK_PQ2_0/4 = 32, TILE_N} uint8   (byte-transposed: 16 rows contiguous)
+//   d  {TILE_N}                  ggml_half
+template <>
+inline void pack_qs<block_pq2_0>(void * RESTRICT packed_B, const block_pq2_0 * RESTRICT B, int KB) {
+    uint8_t * out = (uint8_t *)packed_B;
+    for (int byte_i = 0; byte_i < QK_PQ2_0 / 4; ++byte_i) {
+        for (int row = 0; row < TILE_N; ++row) {
+            out[byte_i * TILE_N + row] = B[row * KB].qs[byte_i];
+        }
+    }
+}
+
+void pack_B(void * RESTRICT packed_B, const block_pq2_0 * RESTRICT B, int KB) {
+    pack_qs(packed_B, B, KB);
+    ggml_half * d = reinterpret_cast<ggml_half *>((char *)packed_B + (QK_PQ2_0 / 4) * TILE_N);
+    for (int n = 0; n < TILE_N; ++n) {
+        d[n] = B[n * KB].d;
+    }
+}
+
+template <int BLOCK_M, int BLOCK_N, int BLOCK_K>
+struct tinygemm_kernel_vnni<block_q8_K, block_pq2_0, float, BLOCK_M, BLOCK_N, BLOCK_K> {
+    static void apply(int KB, const void * RESTRICT _A, const void * RESTRICT _B, float * RESTRICT C, int ldc) {
+        constexpr int COLS = BLOCK_N / 16;
+        const int TILE_SIZE = (QK_PQ2_0 / 4) * TILE_N + TILE_N * sizeof(ggml_half);
+
+        const block_q8_K  * RESTRICT A = static_cast<const block_q8_K *>(_A);
+        const char        * RESTRICT B = static_cast<const char *>(_B);
+
+        __m512 vc[COLS];
+        auto loadc = [&](auto col) { vc[col] = _mm512_setzero_ps(); };
+        Unroll<COLS>{}(loadc);
+
+        auto compute = [&](auto col, auto i) {
+            // two PQ2_0 blocks share one Q8_K block; i&1 picks the half
+            const block_q8_K * RESTRICT ab = &A[i >> 1];
+            const int8_t     * RESTRICT q8 = ab->qs + 128 * (i & 1);
+
+            const char      * b_ptr = B + PACKED_INDEX(col, i, KB, TILE_SIZE);
+            const uint8_t   * b_qs  = (const uint8_t *)b_ptr;
+            const ggml_half * b_d   = (const ggml_half *)(b_ptr + (QK_PQ2_0 / 4) * TILE_N);
+
+            __m512i acc = _mm512_setzero_si512();
+
+            int32_t act_sum = 0;
+            for (int byte_i = 0; byte_i < QK_PQ2_0 / 4; ++byte_i) {
+                // pack_qs made the 16 rows' byte contiguous -> plain zero-extend load
+                __m128i vqs8 = _mm_loadu_si128((const __m128i *)(b_qs + byte_i * TILE_N));
+                __m512i v    = _mm512_cvtepu8_epi32(vqs8);
+
+                // spread the 4 packed 2-bit codes into the 4 bytes of each dword lane
+                __m512i vb = _mm512_or_si512(
+                    _mm512_or_si512(
+                        _mm512_and_si512(v, _mm512_set1_epi32(0x03)),
+                        _mm512_slli_epi32(_mm512_and_si512(v, _mm512_set1_epi32(0x0C)), 6)),
+                    _mm512_or_si512(
+                        _mm512_slli_epi32(_mm512_and_si512(v, _mm512_set1_epi32(0x30)), 12),
+                        _mm512_slli_epi32(_mm512_and_si512(v, _mm512_set1_epi32(0xC0)), 18)));
