+
+                // accumulate sum(q8) for the +1 code bias. NOTE: we must NOT use
+                // Q8_K's bsums here - quantize_row_q8_K_vnni computes them after
+                // transpose_16x4_32bit, so each lane sums a strided set of elements
+                // spread over all four 64B vectors rather than a contiguous group of 16.
+                act_sum += (int32_t)(int8_t)(act_word)       + (int32_t)(int8_t)(act_word >> 8)
+                         + (int32_t)(int8_t)(act_word >> 16) + (int32_t)(int8_t)(act_word >> 24);
+            }
+
+            acc = _mm512_sub_epi32(acc, _mm512_set1_epi32(act_sum));
